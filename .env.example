# StageRank 設定範例 / StageRank example settings
#
# 複製成 .env，填入您自己的值。
# 這個檔案就是「主辦要改的兩樣東西」的所在：網站名稱與金流金鑰。
# Copy this to .env and fill in your own values. This file holds the two things an organiser changes:
# the site name and the payment keys.
#
# 金鑰只放在這裡。它不會進資料庫，也不會出現在程式碼裡。請不要把 .env 上傳到 GitHub。
# Keys live only here. They never enter the database or the source. Never commit .env.

# ---------- 基本 / basics ----------
SITE_NAME=我的舞蹈比賽
BASE_URL=https://example.org
PORT=3000
DEFAULT_LOCALE=zh-TW
CURRENCY=TWD
TZ_DISPLAY=Asia/Taipei

# 主辦後台的通行碼。沒有填，後台會整個停用。
# The organiser passcode. Leave it blank and the back office stays disabled.
ADMIN_TOKEN=

# 用 Google 登入主辦後台（選填）。ADMIN_EMAILS：可以當主辦的信箱，逗號分隔。
# Sign in to the back office with Google (optional). ADMIN_EMAILS: comma-separated organiser emails.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 假 Google（只給開發與測試，NODE_ENV=production 時無效）/ pretend Google, never in production
GOOGLE_LOGIN_MOCK=false

DATABASE_URL=postgres://stagerank:stagerank@db:5432/stagerank
DATABASE_SSL=false

# ---------- 寄信與登入連結 / mail and sign-in links ----------
# 設了 SMTP_URL 和 MAIL_FROM，報名人就改用「寄到信箱的 6 位數驗證碼」登入，不再需要密碼。
# 兩個都沒填，網站照舊用信箱＋密碼。SMTP_URL 例：smtps://user:password@smtp.example.org:465
# With SMTP_URL and MAIL_FROM set, entrants sign in with an emailed 6-digit code and need no password.
# Leave both blank and the site keeps email + password. Example SMTP_URL: smtps://user:password@smtp.example.org:465
SMTP_URL=
MAIL_FROM=
# 開發與測試用：MAIL_MODE=memory 只把信放在記憶體，不會真的寄出（有 SMTP_URL 時以 SMTP 為準）。
# For development and tests: MAIL_MODE=memory keeps mail in memory and sends nothing (SMTP wins when both are set).
# MAIL_MODE=pretend：假裝寄信，6 位數驗證碼直接顯示在畫面上（只給測試站，正式比賽前必須關掉）。
# MAIL_MODE=pretend: pretend mail, the 6-digit code is shown on screen (test site only; turn it off before a real event).
# MAIL_MODE=

# ---------- 範本 / templates ----------
# 額外的範本資料夾：放進去的 *.json 會跟內建範本一起載入，格式見 README「Adding a template or genre」。
# An extra folder of template *.json files, loaded next to the built-in ones. See "Adding a template or genre" in the README.
# TEMPLATE_DIR=

# ---------- 綠界 ECPay ----------
ECPAY_ENABLED=false
ECPAY_SANDBOX=true
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ---------- 藍新 NewebPay ----------
NEWEBPAY_ENABLED=false
NEWEBPAY_SANDBOX=true
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# ---------- PayPal ----------
PAYPAL_ENABLED=false
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. The id of a webhook you created in PayPal; without it webhooks are ignored.
# PAYPAL_WEBHOOK_ID=

# ---------- Stripe ----------
# 請貼「受限金鑰」（rk_ 開頭），不要貼完整權限的 sk_。
# Paste a restricted key (rk_...), not a full secret key (sk_...).
STRIPE_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- 給作者的支持 / supporting the author ----------
#
# StageRank 免費使用，不需付費給作者。唯一的請求是保留下面兩項：
# 頁尾的「Powered by StageRank」標示，以及送給金流平台的夥伴代號。
# 這是請求，不是法律義務；拿掉不違法，我們只是希望您留著，
# 因為它們是這個專案能繼續維護下去的理由。
#
# StageRank is free and you owe the author nothing. The only request is that you keep two things:
# the "Powered by StageRank" footer and the partner IDs sent to the payment providers.
# This is a request, not an obligation. Removing them is not unlawful; we simply hope you leave them
# in place, because they are what keeps this project maintained.
STAGERANK_SHOW_CREDIT=true

# 匿名統計回報：只送網址、交易筆數與金額、比賽場數。
# 絕不含選手個資，也絕不含金鑰。設成 false 就完全不送。
# Anonymous usage reporting: the site URL, payment counts and totals, competition count.
# Never competitor data, never keys. Set to false to send nothing at all.
STAGERANK_REPORT_USAGE=true

# 夥伴代號每天去專案的設定檔看一次（telemetry.json 裡的 partner_ids）。
# 作者簽約那天改一個檔案，已經裝好的每一份隔天自己跟上，不必更新程式。
# 抓不到就留空、格式不對就不用、下面您自己填的永遠優先。設 false 就完全不看。
# Partner ids are read once a day from the project's config file (partner_ids in telemetry.json),
# so one edit on the day a contract is signed reaches every installed copy without an update.
# Unreachable means blank, a bad value is ignored, and anything you set below always wins.
# Set to false to never look.
STAGERANK_REMOTE_PARTNER_IDS=true

# 這幾項覆蓋作者的夥伴代號。一般主辦不需要動。
# These override the author's partner IDs. Ordinary organisers do not need to touch them.
# STAGERANK_ECPAY_PLATFORM_ID=
# STAGERANK_NEWEBPAY_PARTNER_ID=
# STAGERANK_PAYPAL_BN_CODE=
# STAGERANK_STRIPE_PARTNER_ID=
