<p class="small"><a href="/admin/c/<%= competition.id %>">&larr; <%= competition.name %></a></p>
<h1><%= t('setup.title') %></h1>

<% if (message) { %>
  <div class="notice"><%= t(message, typeof messageParams !== 'undefined' ? messageParams : null) %></div>
<% } %>
<% if (error) { %>
  <div class="notice bad"><%= t(error, typeof errorParams !== 'undefined' ? errorParams : null) %></div>
<% } %>

<% if (divisions.length > 0) { %>
  <%# 已經有項目了，就先講結果，再問要不要重來。主辦不必先看一堆選項。 %>
  <%# With divisions already built, the result comes first and the offer to start over second. %>
  <div class="card">
    <p><%= t('setup.summary', { divisions: divisions.length, groups: feeGroups.length }) %></p>
    <p class="small muted">
      <% divisions.slice(0, 6).forEach(function (d, i) { %><%= i > 0 ? ' · ' : '' %><%= d.name %><% }); %>
      <% if (divisions.length > 6) { %> … <% } %>
    </p>
    <p><a class="btn" href="/admin/c/<%= competition.id %>"><%= t('competition.divisions') %></a></p>
  </div>

  <%# 存成我的範本：下次辦別場比賽，可以從「我的範本」一鍵套回來。 %>
  <%# Save as my template: next time, another competition can start from "My templates". %>
  <h2><%= t('setup.saveAsMine') %></h2>
  <div class="card">
    <p class="small muted"><%= t('setup.saveAsMineHint') %></p>
    <form method="post" action="/admin/c/<%= competition.id %>/setup/save-template" class="division-form">
      <div class="field grow">
        <label for="tplName"><%= t('setup.saveName') %></label>
        <input id="tplName" type="text" name="name" required maxlength="80" value="<%= competition.name %>">
      </div>
      <button type="submit"><%= t('setup.saveAsMine') %></button>
    </form>
  </div>

  <h2><%= t('setup.clear') %></h2>
  <div class="card">
    <% if (canClear) { %>
      <p class="small muted"><%= t('setup.clearHint') %></p>
      <form method="post" action="/admin/c/<%= competition.id %>/setup/clear">
        <button type="submit" class="ghost"><%= t('setup.clear') %></button>
      </form>
    <% } else { %>
      <p class="muted"><%= t('setup.locked') %></p>
    <% } %>
  </div>
<% } else { %>
  <h2><%= t('setup.intro') %></h2>

  <% if (sources.length > 0) { %>
    <div class="card">
      <h3 style="margin-top:0; font-size:16px"><%= t('setup.copyFrom') %></h3>
      <p class="small muted"><%= t('setup.copyHint') %></p>
      <form method="post" action="/admin/c/<%= competition.id %>/setup/copy">
        <select name="sourceId" required>
          <% sources.forEach(function (s) { %>
            <option value="<%= s.id %>"><%= t('setup.sourceOption', { name: s.name, count: s.division_count }) %></option>
          <% }); %>
        </select>
        <p style="margin-top:12px"><button type="submit"><%= t('setup.copyButton') %></button></p>
      </form>
    </div>
  <% } %>

  <div class="card">
    <h3 style="margin-top:0; font-size:16px"><%= t('setup.firstTime') %></h3>
    <p class="small muted"><%= t('setup.firstTimeHint') %></p>

    <form method="post" action="/admin/c/<%= competition.id %>/setup/template" id="tplForm">
      <%# 第 1 層類型 → 範本；第 2 層分類、第 3 層組別在下面的清單。 %>
      <%# Level 1 genre -> template; level 2 categories and level 3 divisions are in the list below. %>
      <div class="division-form">
        <div class="field">
          <label for="genreSelect"><%= t('setup.genre') %></label>
          <select id="genreSelect">
            <% picker.genres.forEach(function (g) { %>
              <option value="<%= g.key %>"><%= g.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="field grow">
          <label for="templateKey"><%= t('setup.template') %></label>
          <select id="templateKey" name="templateKey">
            <% picker.panels.forEach(function (panel) { %>
              <option value="<%= panel.key %>" data-genre="<%= panel.genre %>" <%= panel.key === picker.selected ? 'selected' : '' %>><%= panel.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <% picker.panels.forEach(function (panel) { %>
        <% const active = panel.key === picker.selected; %>
        <section class="plan-panel" id="planList-<%= panel.key.replace(/[^A-Za-z0-9_-]/g, '_') %>" data-template="<%= panel.key %>" <%= active ? '' : 'hidden' %>>
          <% if (panel.remembered) { %><p class="small muted"><%= t('setup.remembered') %></p><% } %>

          <% panel.plans.forEach(function (plan) { %>
            <h4 style="font-size:15px; margin:16px 0 4px"><%= t('setup.planTitle', { name: plan.name }) %></h4>
            <div class="division-form">
              <div class="field">
                <label><%= t('admin.baseFee') %></label>
                <input type="text" inputmode="numeric" name="plan_<%= plan.key %>_base" value="<%= plan.base %>" style="width:96px" <%= active ? '' : 'disabled' %>>
              </div>
              <div class="field">
                <label><%= t('admin.baseIncludes') %></label>
                <input type="text" inputmode="numeric" name="plan_<%= plan.key %>_includes" value="<%= plan.includes %>" style="width:72px" <%= active ? '' : 'disabled' %>>
              </div>
              <div class="field">
                <label><%= t('admin.extraItemFee') %></label>
                <input type="text" inputmode="numeric" name="plan_<%= plan.key %>_extra" value="<%= plan.extra %>" style="width:96px" <%= active ? '' : 'disabled' %>>
              </div>
            </div>
          <% }); %>

          <h4 style="font-size:15px; margin:20px 0 4px"><%= t('setup.chooseItems') %></h4>
          <% panel.categories.forEach(function (cat) { %>
            <div class="plan-cat" data-cat="<%= cat.key %>">
              <h5 style="margin:16px 0 0; font-size:14px">
                <%= cat.label %>
                <span class="small muted">(<%= cat.rows.length %>)</span>
                <button type="button" class="ghost small cat-on"><%= t('setup.allOn') %></button>
                <button type="button" class="ghost small cat-off"><%= t('setup.allOff') %></button>
              </h5>
              <% cat.rows.forEach(function (row) { %>
                <label class="roster-pick">
                  <input type="checkbox" name="keys" value="<%= row.key %>" <%= row.checked ? 'checked' : '' %> <%= active ? '' : 'disabled' %>>
                  <span class="roster-name"><%= row.name %></span>
                  <span class="small muted">
                    <%= t('setup.rowDances', { count: row.dances.length }) %>
                    · <%= t('admin.entryKind.' + kindOf({ member_min: row.memberMin, member_max: row.memberMax })) %><%
                    %><% if (row.ageMax) { %> · <%= t('setup.rowAgeMax', { age: row.ageMax }) %><% } %><%
                    %><% if (row.ageMin) { %> · <%= t('setup.rowAgeMin', { age: row.ageMin }) %><% } %>
                  </span>
                </label>
              <% }); %>
            </div>
          <% }); %>
        </section>
      <% }); %>

      <p class="small muted" style="margin-top:20px"><%= t('setup.chooseHint') %></p>
      <p>
        <button type="button" class="ghost small" id="allOn"><%= t('setup.allOn') %></button>
        <button type="button" class="ghost small" id="allOff"><%= t('setup.allOff') %></button>
        <span class="small muted" id="chosenCount"></span>
      </p>

      <p style="margin-top:20px"><button type="submit"><%= t('setup.apply') %></button></p>
    </form>

    <% if (saved.length > 0) { %>
      <h4 style="font-size:15px; margin:24px 0 4px"><%= t('setup.myTemplates') %></h4>
      <% saved.forEach(function (row) { %>
        <form method="post" action="/admin/c/<%= competition.id %>/setup/saved/<%= row.id %>/delete" style="display:flex; gap:8px; align-items:center; margin:4px 0">
          <span><%= row.name %></span>
          <button type="submit" class="ghost small"><%= t('setup.deleteSaved') %></button>
        </form>
      <% }); %>
    <% } %>
  </div>
<% } %>

<script>
  (function () {
    var form = document.getElementById('tplForm');
    if (!form) return;
    var panels = Array.prototype.slice.call(form.querySelectorAll('.plan-panel'));
    var select = document.getElementById('templateKey');
    var genre = document.getElementById('genreSelect');
    var count = document.getElementById('chosenCount');

    function active() {
      return panels.filter(function (p) { return !p.hidden; })[0] || null;
    }
    function boxesOf(root) {
      return Array.prototype.slice.call(root.querySelectorAll('input[type=checkbox]'));
    }
    function refresh() {
      var panel = active();
      if (!panel) return;
      var boxes = boxesOf(panel);
      var on = boxes.filter(function (b) { return b.checked; }).length;
      count.textContent = on + ' / ' + boxes.length;
    }
    // 只有目前這個範本的欄位會送出：其他的關掉，不然會一起被送出去。
    // Only the current template's fields are submitted; the others are disabled so they do not go along.
    function show(key) {
      panels.forEach(function (p) {
        var on = p.getAttribute('data-template') === key;
        p.hidden = !on;
        Array.prototype.forEach.call(p.querySelectorAll('input'), function (i) { i.disabled = !on; });
      });
      refresh();
    }
    function filterGenre() {
      var wanted = genre.value;
      var first = null;
      Array.prototype.forEach.call(select.options, function (o) {
        var match = o.getAttribute('data-genre') === wanted;
        o.hidden = !match;
        o.disabled = !match;
        if (match && !first) first = o;
      });
      var current = select.options[select.selectedIndex];
      if (current && current.disabled && first) select.value = first.value;
      show(select.value);
    }
    function setAll(root, value) {
      boxesOf(root).forEach(function (b) { b.checked = value; });
      refresh();
    }

    document.getElementById('allOn').addEventListener('click', function () { var p = active(); if (p) setAll(p, true); });
    document.getElementById('allOff').addEventListener('click', function () { var p = active(); if (p) setAll(p, false); });
    form.addEventListener('click', function (e) {
      var cat = e.target.closest ? e.target.closest('.plan-cat') : null;
      if (!cat) return;
      if (e.target.classList.contains('cat-on')) setAll(cat, true);
      if (e.target.classList.contains('cat-off')) setAll(cat, false);
    });
    form.addEventListener('change', refresh);
    select.addEventListener('change', function () { show(select.value); });
    genre.addEventListener('change', filterGenre);

    // 開頁時把類型選單對到目前範本的類型。
    // On load, point the genre picker at the current template's genre.
    var current = select.options[select.selectedIndex];
    if (current) genre.value = current.getAttribute('data-genre');
    filterGenre();
  })();
</script>
