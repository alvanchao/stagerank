<p class="small"><a href="/admin/c/<%= competition.id %>">&larr; <%= competition.name %></a></p>
<h1><%= t('setup.title') %></h1>

<% if (message) { %>
  <div class="notice"><%= t(message, typeof messageParams !== 'undefined' ? messageParams : null) %></div>
<% } %>
<% if (error) { %>
  <div class="notice bad"><%= t(error, typeof errorParams !== 'undefined' ? errorParams : null) %></div>
<% } %>

<% if (divisions.length > 0) { %>
  <%# 已經有項目了，就先講結果，再問要不要重來。主辦不必先看一堆選項。 %>
  <%# With divisions already built, the result comes first and the offer to start over second. %>
  <div class="card">
    <p><%= t('setup.summary', { divisions: divisions.length, groups: feeGroups.length }) %></p>
    <p class="small muted">
      <% divisions.slice(0, 6).forEach(function (d, i) { %><%= i > 0 ? ' · ' : '' %><%= d.name %><% }); %>
      <% if (divisions.length > 6) { %> … <% } %>
    </p>
    <p><a class="btn" href="/admin/c/<%= competition.id %>"><%= t('competition.divisions') %></a></p>
  </div>

  <h2><%= t('setup.clear') %></h2>
  <div class="card">
    <% if (canClear) { %>
      <p class="small muted"><%= t('setup.clearHint') %></p>
      <form method="post" action="/admin/c/<%= competition.id %>/setup/clear">
        <button type="submit" class="ghost"><%= t('setup.clear') %></button>
      </form>
    <% } else { %>
      <p class="muted"><%= t('setup.locked') %></p>
    <% } %>
  </div>
<% } else { %>
  <h2><%= t('setup.intro') %></h2>

  <% if (sources.length > 0) { %>
    <div class="card">
      <h3 style="margin-top:0; font-size:16px"><%= t('setup.copyFrom') %></h3>
      <p class="small muted"><%= t('setup.copyHint') %></p>
      <form method="post" action="/admin/c/<%= competition.id %>/setup/copy">
        <select name="sourceId" required>
          <% sources.forEach(function (s) { %>
            <option value="<%= s.id %>"><%= t('setup.sourceOption', { name: s.name, count: s.division_count }) %></option>
          <% }); %>
        </select>
        <p style="margin-top:12px"><button type="submit"><%= t('setup.copyButton') %></button></p>
      </form>
    </div>
  <% } %>

  <div class="card">
    <h3 style="margin-top:0; font-size:16px"><%= t('setup.firstTime') %></h3>
    <p class="small muted"><%= t('setup.firstTimeHint') %></p>

    <form method="post" action="/admin/c/<%= competition.id %>/setup/template">
      <input type="hidden" name="templateKey" value="ballroom">

      <h4 style="font-size:15px; margin-bottom:4px"><%= t('setup.generalPlan') %></h4>
      <div class="division-form">
        <div class="field">
          <label for="gb"><%= t('admin.baseFee') %></label>
          <input id="gb" type="text" inputmode="numeric" name="generalBase" value="1800" style="width:96px">
        </div>
        <div class="field">
          <label for="gi"><%= t('admin.baseIncludes') %></label>
          <input id="gi" type="text" inputmode="numeric" name="generalIncludes" value="2" style="width:72px">
        </div>
        <div class="field">
          <label for="ge"><%= t('admin.extraItemFee') %></label>
          <input id="ge" type="text" inputmode="numeric" name="generalExtra" value="600" style="width:96px">
        </div>
      </div>

      <h4 style="font-size:15px; margin:16px 0 4px"><%= t('setup.proAmPlan') %></h4>
      <div class="division-form">
        <div class="field">
          <label for="pb"><%= t('admin.baseFee') %></label>
          <input id="pb" type="text" inputmode="numeric" name="proAmBase" value="2500" style="width:96px">
        </div>
        <div class="field">
          <label for="pi"><%= t('admin.baseIncludes') %></label>
          <input id="pi" type="text" inputmode="numeric" name="proAmIncludes" value="1" style="width:72px">
        </div>
        <div class="field">
          <label for="pe"><%= t('admin.extraItemFee') %></label>
          <input id="pe" type="text" inputmode="numeric" name="proAmExtra" value="1200" style="width:96px">
        </div>
      </div>

      <h4 style="font-size:15px; margin:20px 0 4px"><%= t('setup.chooseItems') %></h4>
      <p class="small muted"><%= t('setup.chooseHint') %></p>
      <p>
        <button type="button" class="ghost small" id="allOn"><%= t('setup.allOn') %></button>
        <button type="button" class="ghost small" id="allOff"><%= t('setup.allOff') %></button>
        <span class="small muted" id="chosenCount"></span>
      </p>

      <div id="planList">
        <% plan.forEach(function (row) { %>
          <label class="roster-pick">
            <input type="checkbox" name="keys" value="<%= row.key %>" checked>
            <span class="roster-name"><%= row.name %></span>
            <span class="small muted">
              <%= t('setup.rowDances', { count: row.dances.length }) %><%
              %><% if (row.ageMax) { %> · <%= t('setup.rowAgeMax', { age: row.ageMax }) %><% } %><%
              %><% if (row.ageMin) { %> · <%= t('setup.rowAgeMin', { age: row.ageMin }) %><% } %>
            </span>
          </label>
        <% }); %>
      </div>

      <p style="margin-top:20px"><button type="submit"><%= t('setup.apply') %></button></p>
    </form>
  </div>
<% } %>

<script>
  (function () {
    var list = document.getElementById('planList');
    if (!list) return;
    var boxes = Array.prototype.slice.call(list.querySelectorAll('input[type=checkbox]'));
    var count = document.getElementById('chosenCount');

    function refresh() {
      var on = boxes.filter(function (b) { return b.checked; }).length;
      count.textContent = on + ' / ' + boxes.length;
    }
    function setAll(value) {
      boxes.forEach(function (b) { b.checked = value; });
      refresh();
    }

    document.getElementById('allOn').addEventListener('click', function () { setAll(true); });
    document.getElementById('allOff').addEventListener('click', function () { setAll(false); });
    list.addEventListener('change', refresh);
    refresh();
  })();
</script>
