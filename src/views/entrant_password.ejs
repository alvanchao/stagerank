<h1><%= t('entrant.changePassword') %></h1>
<% if (forced) { %><div class="notice"><%= t('entrant.mustChangePassword') %></div><% } %>
<% if (error) { %><div class="notice bad"><%= t(error, typeof errorParams !== 'undefined' ? errorParams : null) %></div><% } %>

<form class="card" method="post" action="/entrant/password">
  <label for="current"><%= forced ? t('entrant.temporaryPassword') : t('entrant.currentPassword') %></label>
  <input id="current" type="password" name="current" required>

  <label for="next"><%= t('entrant.newPassword') %></label>
  <input id="next" type="password" name="next" required minlength="8">
  <p class="small muted"><%= t('entrant.passwordHint') %></p>

  <p style="margin-top:20px"><button type="submit"><%= t('common.save') %></button></p>
</form>
