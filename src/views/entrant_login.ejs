<h1><%= t('entrant.signIn') %></h1>

<% if (error) { %><div class="notice bad"><%= t(error, typeof errorParams !== 'undefined' ? errorParams : null) %></div><% } %>

<form class="card" method="post" action="/entrant/login">
  <label for="email"><%= t('entrant.email') %></label>
  <input id="email" type="email" name="email" required maxlength="180" value="<%= form.email || '' %>">

  <% if (!mailMode) { %>
    <label for="password"><%= t('entrant.password') %></label>
    <input id="password" type="password" name="password" required>
  <% } %>

  <input type="hidden" name="next" value="<%= form.next || '' %>">
  <p style="margin-top:20px"><button type="submit"><%= t('entrant.signIn') %></button></p>
  <% if (mailMode) { %>
    <p class="small muted"><%= t('entrant.mailLoginHint') %></p>
  <% } else { %>
    <p class="small muted"><%= t('entrant.forgotPassword') %></p>
  <% } %>
</form>

<p class="small"><a href="/entrant/signup"><%= t('entrant.noAccount') %></a></p>
